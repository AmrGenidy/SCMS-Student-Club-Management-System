<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="20" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="scms.presentation.EventsController" style="-fx-background-color: #1a1a2e;">
    <Label text="Event Management" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #e0e0e0;"/>

    <HBox spacing="20" VBox.vgrow="ALWAYS">
        <!-- Add Event Form -->
        <VBox spacing="15" prefWidth="300" style="-fx-background-color: #16213e; -fx-background-radius: 10; -fx-padding: 20; -fx-border-color: #4ecdc433; -fx-border-radius: 10;">
            <Label text="Create New Event" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #4ecdc4;"/>

            <VBox spacing="5">
                <Label text="Event ID" style="-fx-text-fill: #a0a0b0; -fx-font-size: 12px;"/>
                <TextField fx:id="idField" promptText="Enter event ID (numeric)" style="-fx-background-color: #0f3460; -fx-text-fill: #e0e0e0; -fx-background-radius: 5;"/>
            </VBox>

            <VBox spacing="5">
                <Label text="Event Name" style="-fx-text-fill: #a0a0b0; -fx-font-size: 12px;"/>
                <TextField fx:id="nameField" promptText="Enter event name" style="-fx-background-color: #0f3460; -fx-text-fill: #e0e0e0; -fx-background-radius: 5;"/>
            </VBox>

            <VBox spacing="5">
                <Label text="Date" style="-fx-text-fill: #a0a0b0; -fx-font-size: 12px;"/>
                <DatePicker fx:id="datePicker" maxWidth="Infinity" style="-fx-background-color: #0f3460;"/>
            </VBox>

            <VBox spacing="5">
                <Label text="Location" style="-fx-text-fill: #a0a0b0; -fx-font-size: 12px;"/>
                <TextField fx:id="locationField" promptText="Enter location" style="-fx-background-color: #0f3460; -fx-text-fill: #e0e0e0; -fx-background-radius: 5;"/>
            </VBox>

            <VBox spacing="5">
                <Label text="Quota" style="-fx-text-fill: #a0a0b0; -fx-font-size: 12px;"/>
                <TextField fx:id="quotaField" promptText="e.g. 50" style="-fx-background-color: #0f3460; -fx-text-fill: #e0e0e0; -fx-background-radius: 5;"/>
            </VBox>

            <Button text="Create Event" onAction="#handleCreateEvent" maxWidth="Infinity" style="-fx-background-color: #4ecdc4; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5; -fx-padding: 10; -fx-cursor: hand;"/>
        </VBox>

        <!-- Events List -->
        <VBox spacing="10" HBox.hgrow="ALWAYS">
            <TableView fx:id="eventTable" VBox.vgrow="ALWAYS" style="-fx-background-color: #16213e; -fx-border-color: #2a2a4a;">
                <columns>
                    <TableColumn fx:id="nameCol" text="Name" prefWidth="150"/>
                    <TableColumn fx:id="dateCol" text="Date" prefWidth="120"/>
                    <TableColumn fx:id="locationCol" text="Location" prefWidth="150"/>
                    <TableColumn fx:id="quotaCol" text="Quota" prefWidth="80"/>
                    <TableColumn fx:id="attendeesCol" text="Attendees" prefWidth="80"/>
                    <TableColumn fx:id="actionCol" text="Action" prefWidth="100"/>
                </columns>
                <placeholder>
                    <Label text="No upcoming events" style="-fx-text-fill: #555566;"/>
                </placeholder>
            </TableView>
        </VBox>
    </HBox>
</VBox>
